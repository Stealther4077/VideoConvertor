<Window x:Class="FileConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FileConverter.App.Models"
        Title="FileConverter"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.42*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FileConverter"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Convert your movie collection — files, batches, or whole folders."
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0"
                           FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding FfmpegStatus}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="360" />
                <Button Content="Locate ffmpeg…"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BrowseFfmpegCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Padding="12,6" />
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="1"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Add files" Style="{StaticResource GhostButton}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                    <Button Content="Add folder" Style="{StaticResource GhostButton}" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="Clear finished" Style="{StaticResource GhostButton}" Command="{Binding ClearFinishedCommand}" Margin="0,0,8,0" />
                    <Button Content="Clear all" Style="{StaticResource GhostButton}" Command="{Binding ClearAllCommand}" Margin="0,0,8,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="Start conversion" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="OUTPUT FORMAT" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding FormatOptions}"
                              SelectedItem="{Binding SelectedFormat}"
                              MinWidth="220"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OutputFormat}">
                                <TextBlock Text="{Binding Converter={StaticResource OutputFormatDisplayConverter}}"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="OUTPUT LOCATION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Same as source"
                                     IsChecked="{Binding UseSameFolderAsSource}"
                                     GroupName="OutputLoc" />
                        <RadioButton Content="Custom folder"
                                     IsChecked="{Binding UseSameFolderAsSource, Converter={StaticResource InverseBoolConverter}}"
                                     GroupName="OutputLoc" />
                    </StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Browse…"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseOutputFolderCommand}"
                                Margin="8,0,0,0"
                                Padding="12,6" />
                        <TextBox Text="{Binding CustomOutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UseSameFolderAsSource, Converter={StaticResource InverseBoolConverter}}"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="OPTIONS" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                    <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,0,8" />
                    <CheckBox Content="Overwrite existing outputs" IsChecked="{Binding OverwriteExisting}" Margin="0,0,0,8" />
                    <CheckBox Content="Skip if already H.264 (smart)" IsChecked="{Binding SkipCompatibleCodec}" Margin="0,0,0,8"
                              ToolTip="Skip files whose video is already H.264 (works on TCL Google TV and Nebula Apollo). Uncheck to force re-encode." />
                    <CheckBox Content="Delete original after success" IsChecked="{Binding DeleteOriginalAfterSuccess}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Queue -->
        <Border Grid.Row="3"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,10">
                    <TextBlock Text="QUEUE"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="Drop files or folders here"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <ListView x:Name="JobList"
                          ItemsSource="{Binding Jobs}"
                          SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Progress" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" />

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="420">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Overall progress -->
        <Border Grid.Row="4"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="OVERALL" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding OverallStatus}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               MaxWidth="720" />
                </DockPanel>
                <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="12" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="ETA" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding EstimatedTimeRemaining}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="5"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="ACTIVITY"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="4,2,4,8" />
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas, Cascadia Mono, Courier New"
                         FontSize="12.5"
                         Foreground="{StaticResource TextMutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
